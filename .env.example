# IECMS Companion — environment template.
#
# Copy this file to `.env` and fill in real values locally.
# NEVER commit the real `.env` file or any API key to version control.

# --- Django -------------------------------------------------------------
# Set to false for any non-development deployment.
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG is false. Generate a long random value.
DJANGO_SECRET_KEY=
# Comma-separated host names, e.g. "127.0.0.1,localhost".
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Chat behaviour -----------------------------------------------------
# false = run the real retrieval-grounded pipeline (default).
# true  = serve clearly-labelled MOCK placeholders (interface development only).
ENABLE_MOCK_CHAT=false
CHAT_MIN_QUESTION_LENGTH=2
CHAT_MAX_QUESTION_LENGTH=500

# --- Cloud LLM provider -------------------------------------------------
# The provider is called only when an API key is present. With no key the app
# quotes retrieved sources verbatim instead of generating text.
#
# Any LLM_PROVIDER other than "gemini" is treated as OpenAI-compatible and is
# called at LLM_BASE_URL + /chat/completions. Free cloud options:
#
#  Google Gemma  (free key: https://aistudio.google.com/apikey)      [default]
#      Served by Google's OpenAI-compatible endpoint; nothing runs locally.
#      LLM_PROVIDER=google
#      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#      LLM_MODEL=gemma-4-31b-it    # check /v1beta/openai/models for current ids
#      GEMINI_API_KEY=<your key>
#
#  Cerebras  (free key: https://cloud.cerebras.ai)
#      LLM_PROVIDER=cerebras
#      LLM_BASE_URL=https://api.cerebras.ai/v1
#      LLM_MODEL=llama3.1-8b        # check the dashboard for current model ids
#      CEREBRAS_API_KEY=<your key>
#
#  Groq  (free key: https://console.groq.com)
#      LLM_PROVIDER=groq
#      LLM_BASE_URL=https://api.groq.com/openai/v1
#      LLM_MODEL=llama-3.3-70b-versatile
#      LLM_API_KEY=<your key>
#
#  OpenRouter  (free key: https://openrouter.ai; use a model id ending ':free')
#      LLM_PROVIDER=openrouter
#      LLM_BASE_URL=https://openrouter.ai/api/v1
#      LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#      LLM_API_KEY=<your key>
#
#  Google Gemini  (free key: https://aistudio.google.com)
#      LLM_PROVIDER=gemini
#      LLM_MODEL=gemini-2.0-flash
#      GEMINI_API_KEY=<your key>
#
#  Ollama Cloud  (needs the local Ollama client; the model runs remotely)
#      LLM_PROVIDER=ollama
#      LLM_BASE_URL=http://localhost:11434/v1
#      LLM_MODEL=<a -cloud model tag>
#      LLM_API_KEY=ollama
#
# Models that reject a "system" role (notably Gemma) are retried automatically
# with the instruction folded into the user message.
LLM_PROVIDER=google
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemma-4-31b-it
# LLM_API_KEY is preferred; CEREBRAS_API_KEY and GEMINI_API_KEY also work.
LLM_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
LLM_REQUEST_TIMEOUT=60
LLM_MAX_OUTPUT_TOKENS=1024
# The free Gemma tier returns intermittent HTTP 500s, so allow a few tries.
LLM_MAX_ATTEMPTS=3
LLM_TEMPERATURE=0.2
# Set to false to disable verbatim quotation when no provider is configured.
LLM_ALLOW_EXTRACTIVE_FALLBACK=true

# --- Open-web fallback (off by default) ---------------------------------
# When the approved corpus cannot establish an answer, search the open web
# instead of refusing. Every result is labelled an UNVERIFIED WEB SOURCE with
# its exact URL and retrieval date, and is never presented as official law.
# robots.txt is honoured before every fetch.
#
# Enabled by default: when the approved corpus cannot answer, fetch from the
# open web and cite the pages (URL + host + retrieval date). Set to false to
# restore the strict "no approved evidence, no answer" rule.
ENABLE_WEB_FALLBACK=true
WEB_SEARCH_MAX_RESULTS=4
WEB_SEARCH_TIMEOUT=20
WEB_FETCH_MAX_BYTES=2097152
WEB_FETCH_MAX_PASSAGES=4

# --- Retrieval ----------------------------------------------------------
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=1.0
# Synthetic test fixtures may ground an answer only when true, and the answer
# always discloses that the source is synthetic. Defaults to DJANGO_DEBUG.
# Never enable this in a real deployment.
ALLOW_SYNTHETIC_SOURCES=false

# --- IECMS manual assistant --------------------------------------------
# Procedural IECMS questions are answered only from approved manuals, never
# from the legal definitions corpus or an open-web search.
ENABLE_IECMS_MANUAL_ASSISTANT=true
# Comma-separated source ids from legal_sources/manifests/iecms-manuals.json.
IECMS_MANUAL_SOURCE_IDS=zw-iecms-user-manual
# Manual questions need a few adjacent passages (a heading plus its steps).
IECMS_MANUAL_TOP_K=12
IECMS_MANUAL_MIN_SCORE=1.0
# Shown with every manual answer. The supplied manual is the 2021 edition.
IECMS_MANUAL_VERSION_NOTE=Based on the IECMS Getting Started Guide — Public Users, Version 1.1 (2021). The live IECMS interface and its procedures may have changed since publication; confirm the current steps in IECMS.

# --- Source fetching ----------------------------------------------------
# Comma-separated allow-list. A host must be listed before it can be ingested.
SOURCE_ALLOWED_HOSTS=www.jsc.org.zw,jsc.org.zw,www.veritaszim.net,veritaszim.net
SOURCE_FETCH_TIMEOUT=20
SOURCE_FETCH_MIN_INTERVAL=1.0
SOURCE_RESPECT_ROBOTS=true
SOURCE_USER_AGENT=IECMS-Companion-Prototype/0.1 (+educational prototype)
