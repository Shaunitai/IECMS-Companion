{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "IECMS: Run server",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": [
				"manage.py",
				"runserver",
				"127.0.0.1:8000"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"isBackground": true
		},
		{
			"label": "IECMS: Run tests",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": [
				"manage.py",
				"test"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"group": {
				"kind": "test",
				"isDefault": true
			}
		},
		{
			"label": "IECMS: Load synthetic corpus (dev only)",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": [
				"manage.py",
				"load_synthetic_corpus"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "IECMS: Rebuild search index",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": [
				"manage.py",
				"build_index"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "IECMS: Ingest real sources",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": [
				"manage.py",
				"ingest_sources",
				"--manifest",
				"legal_sources/manifests/real-sources.json"
			],
			"problemMatcher": []
		},
		{
			"label": "IECMS: Ingest IECMS manuals (OCR)",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": [
				"manage.py",
				"ingest_sources",
				"--manifest",
				"legal_sources/manifests/iecms-manuals.json"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "IECMS: OCR scanned sources",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": [
				"manage.py",
				"ingest_sources",
				"--manifest",
				"legal_sources/manifests/scanned-sources.json"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		}
	]
}